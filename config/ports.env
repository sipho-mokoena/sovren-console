# The port registry. Single source of truth for every port sovren publishes.
#
# Consumed by the Makefile, by docker compose (via env_file), and by the
# documentation site, which renders this file rather than restating it.
#
# One rule: never write a port number anywhere else. If a service needs a port,
# add it here, then make everything else read it from here.

# The console. 4141 sits clear of Vite's 5173 and TanStack Start's 3000.
SOVREN_CONSOLE_PORT=4141

# The documentation site. 4142.
SOVREN_DOCS_PORT=4142

# The control plane's REST API. 4143. Reserved now, served once packages/api
# exists -- see .scratch/prototype-console-and-docs/issues/.
SOVREN_API_PORT=4143

# PostgreSQL 17. 45432, so it cannot collide with a developer's 5432.
SOVREN_POSTGRES_PORT=45432
