{
  "name": "@sovren/client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated/index.ts",
    "./models": "./src/generated/model/index.ts",
    "./msw": "./src/msw.ts",
    "./zod": "./src/generated/zod/index.ts"
  },
  "scripts": {
