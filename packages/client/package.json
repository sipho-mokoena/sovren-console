    "test": "vitest run"
  },
  "dependencies": {
    "@faker-js/faker": "^10.0.0",
    "@tanstack/react-query": "^5.90.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "msw": "^2.11.0",
    "orval": "^8.38.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
